<%- include('../partials/header') %>
<div class="container admin-layout"><%- include('../partials/admin-nav') %><section class="admin-products-page">
<div class="section-head admin-products-heading"><div><span class="section-kicker">HOMEPAGE MANAGEMENT</span><h1>Site Popup</h1><p class="small">This card pops up when a customer opens the site — use it for new collection launches or offers. Keep only one Active at a time.</p></div><a class="btn gold-btn" href="/admin/popups/new"><i class="bi bi-plus-lg"></i> Add popup</a></div>
<% const safePopups = Array.isArray(popups) ? popups : []; %>
<div class="admin-product-summary-grid"><article><span>Total</span><strong><%= safePopups.length %></strong></article><article><span>Active</span><strong><%= safePopups.filter(p => p.active).length %></strong></article><article><span>Hidden</span><strong><%= safePopups.filter(p => !p.active).length %></strong></article></div>
<% if (safePopups.length) { %><div class="admin-table-wrap"><table class="admin-products-table"><thead><tr><th>Popup</th><th>Button</th><th>Status</th><th>Action</th></tr></thead><tbody><% safePopups.forEach(popup => { %><tr>
<td><div class="admin-product-cell"><div class="admin-product-image"><img src="<%= popup.image?.url || 'https://via.placeholder.com/300x160?text=Popup' %>" alt="<%= popup.title || 'Popup' %>"></div><div><strong><%= popup.title || 'Untitled popup' %></strong><small><%= popup.description || '' %></small></div></div></td><td><%= popup.buttonText || 'Shop Now' %> → <%= popup.buttonLink || '/shop' %></td><td><span class="status-pill <%= popup.active ? 'active' : 'inactive' %>"><%= popup.active ? 'Active' : 'Inactive' %></span></td><td><div class="table-actions"><a class="btn small-btn" href="/admin/popups/<%= popup._id %>/edit">Edit</a><% if (popup.active) { %><form method="post" action="/admin/popups/<%= popup._id %>/delete" onsubmit="return confirm('Deactivate this popup?')"><button class="btn ghost-btn small-btn" type="submit">Deactivate</button></form><% } %></div></td>
</tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><h2>No popup yet</h2><p>Add an image to show as a popup card to every visitor.</p><a class="btn gold-btn" href="/admin/popups/new">Add popup</a></div><% } %>
</section></div><%- include('../partials/footer') %>
