<%- include('../partials/header') %>
<div class="container admin-layout"><%- include('../partials/admin-nav') %><section class="admin-products-page">
<div class="section-head admin-products-heading"><div><span class="section-kicker">HOMEPAGE MANAGEMENT</span><h1>Site Popup</h1><p class="small">Upload a square popup card only. It opens automatically for a visitor when they first enter the site.</p></div><a class="btn gold-btn" href="/admin/popups/new"><i class="bi bi-upload"></i> Upload popup card</a></div>
<% const safePopups = Array.isArray(popups) ? popups : []; %>
<div class="admin-product-summary-grid"><article><span>Total cards</span><strong><%= safePopups.length %></strong></article><article><span>Active</span><strong><%= safePopups.filter(p => p.active).length %></strong></article><article><span>Hidden</span><strong><%= safePopups.filter(p => !p.active).length %></strong></article></div>
<% if (safePopups.length) { %><div class="admin-table-wrap"><table class="admin-products-table"><thead><tr><th>Popup card</th><th>Status</th><th>Action</th></tr></thead><tbody><% safePopups.forEach(popup => { %><tr>
<td><div class="admin-product-cell"><div class="admin-product-image" style="aspect-ratio:1/1;overflow:hidden;"><img src="<%= popup.image?.url || 'https://via.placeholder.com/300x300?text=Popup' %>" alt="Popup card" style="width:100%;height:100%;object-fit:cover;"></div><div><strong>Square popup card</strong><small>Recommended: 1080 × 1080 px</small></div></div></td><td><span class="status-pill <%= popup.active ? 'active' : 'inactive' %>"><%= popup.active ? 'Active' : 'Inactive' %></span></td><td><div class="table-actions"><a class="btn small-btn" href="/admin/popups/<%= popup._id %>/edit">Replace image</a><% if (popup.active) { %><form method="post" action="/admin/popups/<%= popup._id %>/delete" onsubmit="return confirm('Deactivate this popup card?')"><button class="btn ghost-btn small-btn" type="submit">Deactivate</button></form><% } %></div></td>
</tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><h2>No popup card yet</h2><p>Upload one square image to show as the site popup.</p><a class="btn gold-btn" href="/admin/popups/new">Upload popup card</a></div><% } %>
</section></div><%- include('../partials/footer') %>
