<%- include('../partials/header') %>
<div class="container admin-layout"><%- include('../partials/admin-nav') %><section class="panel">
<div class="admin-form-heading"><div><span class="section-kicker">HOMEPAGE MANAGEMENT</span><h1><%= popup ? 'Replace popup card' : 'Upload popup card' %></h1><p class="small">Upload one square popup image. Recommended size: <strong>1080 × 1080 px</strong> (1:1). Replacing an image updates the same popup card.</p></div></div>
<form id="popupUploadForm" method="post" enctype="multipart/form-data" action="<%= popup ? '/admin/popups/' + popup._id : '/admin/popups' %>">
<input type="hidden" name="active" value="on">
<div class="field">
  <label>Square popup card</label>
  <input type="file" name="imageFile" accept="image/png,image/jpeg,image/webp" <%= cloudinaryReady ? '' : 'disabled' %> <%= popup?.image?.url ? '' : 'required' %>>
  <p class="small"><%= cloudinaryReady ? 'Use a square JPG, PNG or WebP. Best result: 1080 × 1080 px.' : 'Cloudinary is not configured, so popup upload is currently unavailable.' %></p>
</div>
<% if (popup?.image?.url) { %>
  <div style="width:min(360px,100%);aspect-ratio:1/1;margin:18px 0 22px;overflow:hidden;border-radius:10px;border:1px solid var(--line);background:#f4f1e8;">
    <img src="<%= popup.image.url %>" alt="Current popup card" style="width:100%;height:100%;object-fit:cover;display:block;">
  </div>
<% } %>
<div class="form-actions"><button id="popupSubmitButton" class="btn gold-btn" type="submit"><span class="popup-submit-label"><%= popup ? 'Replace popup card' : 'Upload popup card' %></span></button><a class="btn ghost-btn" href="/admin/popups">Cancel</a></div>
</form>
<script>
(() => {
  const form = document.getElementById('popupUploadForm');
  const button = document.getElementById('popupSubmitButton');
  if (!form || !button) return;

  let submitting = false;
  form.addEventListener('submit', event => {
    if (submitting) {
      event.preventDefault();
      return;
    }

    submitting = true;
    button.disabled = true;
    button.setAttribute('aria-busy', 'true');
    button.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Saving...';
  });
})();
</script>
</section></div><%- include('../partials/footer') %>
