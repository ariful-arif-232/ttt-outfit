<%- include('../partials/header') %>
<div class="container admin-layout"><%- include('../partials/admin-nav') %><section class="panel">
<div class="admin-form-heading"><div><span class="section-kicker">HOMEPAGE MANAGEMENT</span><h1><%= popup ? 'Replace popup card' : 'Upload popup card' %></h1><p class="small">Upload one square popup image. Recommended size: <strong>1080 × 1080 px</strong> (1:1). The card will appear automatically when a customer first enters the site.</p></div></div>
<form method="post" enctype="multipart/form-data" action="<%= popup ? '/admin/popups/' + popup._id : '/admin/popups' %>">
<input type="hidden" name="active" value="on">
<div class="field">
  <label>Square popup card</label>
  <input type="file" name="imageFile" accept="image/png,image/jpeg,image/webp" <%= cloudinaryReady ? '' : 'disabled' %> <%= popup?.image?.url ? '' : 'required' %>>
  <p class="small"><%= cloudinaryReady ? 'Use a square JPG, PNG or WebP. Best result: 1080 × 1080 px.' : 'Cloudinary is not configured, so popup upload is currently unavailable.' %></p>
</div>
<% if (popup?.image?.url) { %>
  <div style="width:min(360px,100%);aspect-ratio:1/1;margin:18px 0 22px;overflow:hidden;border-radius:10px;border:1px solid var(--line);background:#f4f1e8;">
    <img src="<%= popup.image.url %>" alt="Current popup card" style="width:100%;height:100%;object-fit:cover;display:block;">
  </div>
<% } %>
<div class="form-actions"><button class="btn gold-btn" type="submit"><%= popup ? 'Replace popup card' : 'Upload popup card' %></button><a class="btn ghost-btn" href="/admin/popups">Cancel</a></div>
</form></section></div><%- include('../partials/footer') %>
