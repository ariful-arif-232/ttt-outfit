<script>
  document.addEventListener('DOMContentLoaded', () => {
    const flashToast =
      document.getElementById('flashToast');

    if (!flashToast) return;

    const removeToast = () => {
      if (flashToast && flashToast.parentNode) {
        flashToast.remove();
      }
    };

    setTimeout(removeToast, 5200);
  });
</script>
<script>
document.addEventListener('click', event => {
  const colorButton =
    event.target.closest('.product-color-option');

  if (colorButton) {
    const card =
      colorButton.closest('.professional-product-card');

    if (!card) return;

    card
      .querySelectorAll('.product-color-option')
      .forEach(button => {
        button.classList.remove('active');
      });

    colorButton.classList.add('active');

    const colorInput =
      card.querySelector('[data-selected-color]');

    if (colorInput) {
      colorInput.value =
        colorButton.dataset.color || '';
    }

const mainImage =
  card.querySelector('.product-primary-image');

const secondImage =
  card.querySelector('.product-secondary-image');

if (
  mainImage &&
  colorButton.dataset.image
) {
  mainImage.src =
    colorButton.dataset.image;
}

if (
  secondImage &&
  colorButton.dataset.secondImage
) {
  secondImage.src =
    colorButton.dataset.secondImage;
}

    let sizes = [];

    try {
      sizes = JSON.parse(
        colorButton.dataset.sizes || '[]'
      );
    } catch {
      sizes = [];
    }

    const sizeContainer =
      card.querySelector('[data-size-options]');

    const sizeInput =
      card.querySelector('[data-selected-size]');

    if (sizeContainer) {
      sizeContainer.innerHTML = '';

      sizes.forEach((size, index) => {
        const button =
          document.createElement('button');

        button.type = 'button';
        button.className =
          'product-size-option' +
          (index === 0 ? ' active' : '');

        button.dataset.size = size;
        button.textContent = size;

        sizeContainer.appendChild(button);
      });
    }

const selectedStock =
  Number(
    colorButton.dataset.stock || 0
  );

const cartForm =
  card.querySelector('.quick-cart-form');

const addButton =
  cartForm?.querySelector(
    'button[type="submit"]'
  );

if (addButton) {
  addButton.disabled =
    selectedStock < 1;

  const buttonText =
    addButton.querySelector('span');

  if (buttonText) {
    buttonText.textContent =
      selectedStock > 0
        ? 'Add to cart'
        : 'Out of stock';
  }
}
    return;
  }

  const sizeButton =
    event.target.closest('.product-size-option');

  if (sizeButton) {
    const card =
      sizeButton.closest('.professional-product-card');

    if (!card) return;

    card
      .querySelectorAll('.product-size-option')
      .forEach(button => {
        button.classList.remove('active');
      });

    sizeButton.classList.add('active');

    const sizeInput =
      card.querySelector('[data-selected-size]');

    if (sizeInput) {
      sizeInput.value =
        sizeButton.dataset.size || '';
    }
  }
});
</script>

<% if (sitePopup && sitePopup.image && sitePopup.image.url) { %>
<div
  class="site-offer-modal"
  id="siteOfferModal"
  aria-hidden="true"
>
  <div
    class="site-offer-backdrop"
    data-close-site-offer
  ></div>

  <div
    class="site-offer-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="siteOfferTitle"
  >
    <button
      class="site-offer-close"
      type="button"
      aria-label="Close"
      data-close-site-offer
    >
      <i class="bi bi-x-lg"></i>
    </button>

    <a
      href="<%= sitePopup.buttonLink || '/shop' %>"
      class="site-offer-image-link"
    >
      <img src="<%= sitePopup.image.url %>" alt="<%= sitePopup.title || 'Offer' %>" id="siteOfferTitle">

      <span class="offer-shop-button">
        <%= sitePopup.buttonText || 'Shop Now' %>
        <i class="bi bi-arrow-right"></i>
      </span>
    </a>
  </div>
</div>
<script>

document.addEventListener('DOMContentLoaded', () => {
  const offerModal = document.getElementById('siteOfferModal');
  if (!offerModal) return;

  const alreadyShown = sessionStorage.getItem('tttSitePopupShown');

  const openOffer = () => {
    offerModal.classList.add('show');
    offerModal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('offer-modal-open');
    sessionStorage.setItem('tttSitePopupShown', '1');
  };

  const closeOffer = () => {
    offerModal.classList.remove('show');
    offerModal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('offer-modal-open');
  };

  if (!alreadyShown) {
    setTimeout(openOffer, 600);
  }

  offerModal.addEventListener('click', event => {
    if (event.target.closest('[data-close-site-offer]')) closeOffer();
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && offerModal.classList.contains('show')) closeOffer();
  });
});
</script>
<% } %>

<!-- Site-wide product card zoom lightbox -->
<div class="product-image-modal" id="cardZoomModal" aria-hidden="true">
  <button class="product-modal-close" id="cardZoomClose" type="button" aria-label="Close image">×</button>
  <img id="cardZoomImage" src="" alt="Product preview">
</div>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const zoomModal = document.getElementById('cardZoomModal');
  const zoomImage = document.getElementById('cardZoomImage');
  if (!zoomModal || !zoomImage) return;

  function openZoom(imgSrc, altText) {
    zoomImage.src = imgSrc;
    zoomImage.alt = altText || 'Product preview';
    zoomModal.classList.add('active');
    zoomModal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('ttt-drawer-lock');
  }

  function closeZoom() {
    zoomModal.classList.remove('active');
    zoomModal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('ttt-drawer-lock');
  }

  document.addEventListener('click', event => {
    const trigger = event.target.closest('.ttt-card-zoom-icon');
    if (trigger) {
      event.preventDefault();
      const card = trigger.closest('.product-image-wrap');
      const img = card?.querySelector('.product-primary-image');
      if (img && img.src) openZoom(img.src, img.alt);
      return;
    }
    if (event.target === zoomModal || event.target.closest('#cardZoomClose')) {
      closeZoom();
    }
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && zoomModal.classList.contains('active')) closeZoom();
  });
});
</script>
</body>
</html>
